# ====================================================================
# EcoRide - variables d'environnement
# Copier ce fichier en « .env » puis remplacer les valeurs.
# Le fichier .env n'est JAMAIS commité (voir .gitignore).
# ====================================================================

# --- Base PostgreSQL ---
# En local sans Docker :
DATABASE_URL=postgres://ecoride:changez-moi@localhost:5432/ecoride
# Mot de passe utilisé par docker-compose pour créer la base
POSTGRES_PASSWORD=changez-moi

# --- Base MongoDB (optionnelle : sans elle, préférences gardées en mémoire) ---
MONGO_URL=mongodb://localhost:27017/ecoride

# --- Firebase (console Firebase > Paramètres du projet > Vos applications) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Développement : émulateur Firebase Auth local (ex. 127.0.0.1:9099), laisser vide sinon
VITE_FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_APP_ID=
# Utilisé par le serveur pour vérifier les tokens (même valeur que ci-dessus)
FIREBASE_PROJECT_ID=

# --- Secret de signature des JWT employés ---
# Générer une valeur aléatoire : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000
